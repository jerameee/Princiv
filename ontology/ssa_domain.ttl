:FunctionalDomain a owl:Class ;
    rdfs:label "Functional Domain" ;
    rdfs:comment "Area of functioning assessed for childhood disability (20 C.F.R. § 416.926a)" .

:AcquiringAndUsingInformation a owl:Class ;
    rdfs:subClassOf :FunctionalDomain ;
    rdfs:label "Acquiring and Using Information" .

:AttendingAndCompletingTasks a owl:Class ;
    rdfs:subClassOf :FunctionalDomain ;
    rdfs:label "Attending and Completing Tasks" .

:InteractingAndRelatingWithOthers a owl:Class ;
    rdfs:subClassOf :FunctionalDomain ;
    rdfs:label "Interacting and Relating with Others" .

:MovingAboutAndManipulatingObjects a owl:Class ;
    rdfs:subClassOf :FunctionalDomain ;
    rdfs:label "Moving About and Manipulating Objects" .

:CaringForYourself a owl:Class ;
    rdfs:subClassOf :FunctionalDomain ;
    rdfs:label "Caring for Yourself" .

:HealthAndPhysicalWellBeing a owl:Class ;
    rdfs:subClassOf :FunctionalDomain ;
    rdfs:label "Health and Physical Well-Being" .

:LimitationLevel a owl:Class ;
    rdfs:label "Limitation Level" ;
    rdfs:comment "Degree of limitation in functional domain" .

:NoLimitation a :LimitationLevel ;
    rdfs:label "No limitation" .

:LessThanMarked a :LimitationLevel ;
    rdfs:label "Less than marked limitation" .

:MarkedLimitation a :LimitationLevel ;
    rdfs:label "Marked limitation" ;
    rdfs:comment "Serious limitation (2 marked = disabled)" .

:ExtremeLimitation a :LimitationLevel ;
    rdfs:label "Extreme limitation" ;
    rdfs:comment "Very serious limitation (1 extreme = disabled)" .

# Properties

:hasLimitationInDomain a owl:ObjectProperty ;
    rdfs:domain :ChildClaimant ;
    rdfs:range :FunctionalDomain ;
    rdfs:label "has limitation in domain" .

:limitationLevel a owl:ObjectProperty ;
    rdfs:range :LimitationLevel ;
    rdfs:label "limitation level" .

# =============================================================================
# BENEFIT CALCULATIONS & CONCURRENT BENEFITS
# =============================================================================

:BenefitCalculation a owl:Class ;
    rdfs:label "Benefit Calculation" ;
    rdfs:comment "Computation of monthly payment amount" .

:SSDIBenefitAmount a owl:Class ;
    rdfs:subClassOf :BenefitCalculation ;
    rdfs:label "SSDI Benefit Amount" ;
    rdfs:comment "Based on lifetime earnings (Average Indexed Monthly Earnings)" .

:SSIBenefitAmount a owl:Class ;
    rdfs:subClassOf :BenefitCalculation ;
    rdfs:label "SSI Benefit Amount" ;
    rdfs:comment "Federal Benefit Rate minus countable income" .

:ConcurrentBenefitCalculation a owl:Class ;
    rdfs:subClassOf :BenefitCalculation ;
    rdfs:label "Concurrent Benefit Calculation" ;
    rdfs:comment "SSI supplements SSDI if SSDI is below FBR" .

:TitleIIOffset a owl:Class ;
    rdfs:label "Title II Offset" ;
    rdfs:comment "SSDI payment reduces SSI dollar-for-dollar" .

:StateSupplementation a owl:Class ;
    rdfs:label "State Supplementation" ;
    rdfs:comment "Additional SSI payment from state" .

# Benefit Properties

:monthlyBenefitAmount a owl:DatatypeProperty ;
    rdfs:domain :BenefitCalculation ;
    rdfs:range xsd:decimal ;
