:MedicalFinding a owl:Class ;
    rdfs:label "Medical Finding" ;
    rdfs:comment "Specific clinical observation or test result" .

:NerveRootCompression a owl:Class ;
    rdfs:subClassOf :MedicalFinding ;
    rdfs:label "Nerve Root Compression" .

:MotorLoss a owl:Class ;
    rdfs:subClassOf :MedicalFinding ;
    rdfs:label "Motor Loss" .

:SensoryLoss a owl:Class ;
    rdfs:subClassOf :MedicalFinding ;
    rdfs:label "Sensory Loss" .

