# ANNOTATIONS & METADATA
# =============================================================================

# All classes and properties should have annotations

:hasRegulatoryCitation a owl:AnnotationProperty ;
    rdfs:label "has regulatory citation" .

:hasSSRGuidance a owl:AnnotationProperty ;
    rdfs:label "has SSR guidance" .

:hasPOMSReference a owl:AnnotationProperty ;
    rdfs:label "has POMS reference" .

:lastUpdated a owl:AnnotationProperty ;
    rdfs:label "last updated" .

# =============================================================================
# MISSING CLASS DEFINITIONS (Task 1.1.1)
# =============================================================================

## MedicalCondition — equivalent alias for Impairment
:MedicalCondition a owl:Class ;
    owl:equivalentClass :Impairment ;
    rdfs:label "Medical Condition" ;
    rdfs:comment "Alias for :Impairment; medically determinable physical or mental condition" .

## SSR — equivalent alias for SocialSecurityRuling
:SSR a owl:Class ;
    owl:equivalentClass :SocialSecurityRuling ;
    rdfs:label "SSR" ;
    rdfs:comment "Abbreviated alias for :SocialSecurityRuling" .

## RFCComponent — parent of exertional/non-exertional RFC dimensions
:RFCComponent a owl:Class ;
    rdfs:subClassOf :Concept ;
    rdfs:label "RFC Component" ;
    rdfs:comment "A discrete component of an RFC assessment (exertional or non-exertional)" .

:ExertionalRFCComponent a owl:Class ;
    rdfs:subClassOf :RFCComponent ;
    rdfs:label "Exertional RFC Component" ;
    rdfs:comment "Strength-based RFC dimensions: lifting, carrying, standing, walking, sitting" .

:NonExertionalRFCComponent a owl:Class ;
    rdfs:subClassOf :RFCComponent ;
    rdfs:label "Non-Exertional RFC Component" ;
    rdfs:comment "Mental, sensory, manipulative, postural, and environmental RFC dimensions" .

## DOT — Dictionary of Occupational Titles
:DOT a owl:Class ;
    rdfs:subClassOf :Document ;
    rdfs:label "Dictionary of Occupational Titles (DOT)" ;
    rdfs:comment "U.S. DOL reference for occupational demands used by vocational experts at Step 5" .

:DOTOccupation a owl:Class ;
    rdfs:subClassOf :Occupation ;
    rdfs:label "DOT Occupation" ;
    rdfs:comment "An individual occupation entry in the Dictionary of Occupational Titles" .

## CourtCase — general superclass aligned with JudicialOpinion hierarchy
:CourtCase a owl:Class ;
    rdfs:subClassOf :LegalAuthority ;
    rdfs:label "Court Case" ;
    rdfs:comment "A judicial proceeding; superclass for JudicialOpinion and related case records" .

:JudicialOpinion rdfs:subClassOf :CourtCase .

## EvidenceType — generic parent for evidence classification subtypes
:EvidenceType a owl:Class ;
    rdfs:subClassOf :Concept ;
    rdfs:label "Evidence Type" ;
    rdfs:comment "Classification of evidence by nature or source (medical, vocational, testimonial, etc.)" .

# =============================================================================
# MISSING OBJECT PROPERTY DEFINITIONS (Task 1.1.2)
# =============================================================================

:causesSymptom a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :MedicalCondition :Impairment ) ] ;
    rdfs:range :FunctionalLimitation ;
    rdfs:label "causes symptom" ;
    rdfs:comment "A medical condition or impairment produces this functional limitation as a symptom" .

:resultsInLimitation a owl:ObjectProperty ;
    rdfs:domain :Impairment ;
    rdfs:range :FunctionalLimitation ;
    rdfs:label "results in limitation" ;
    rdfs:comment "Impairment directly produces this functional limitation" .

:mayMeetListing a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :MedicalCondition :Impairment ) ] ;
    rdfs:range :Listing ;
    rdfs:label "may meet listing" ;
    rdfs:comment "Medical condition that potentially satisfies a Listing of Impairments" .

:requiresEvidence a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Listing :EvaluationStep ) ] ;
    rdfs:range :EvidenceType ;
    rdfs:label "requires evidence" ;
    rdfs:comment "Listing criterion or evaluation step requires this category of evidence" .

:affectsRFCComponent a owl:ObjectProperty ;
    rdfs:domain :FunctionalLimitation ;
    rdfs:range :RFCComponent ;
    rdfs:label "affects RFC component" ;
    rdfs:comment "Functional limitation impacts this RFC component" .

:restrictsToWorkLevel a owl:ObjectProperty ;
    rdfs:domain :ResidualFunctionalCapacity ;
    rdfs:range :ExertionalLevel ;
    rdfs:label "restricts to work level" ;
    rdfs:comment "RFC constrains the claimant to this exertional work level" .

:compatibleWithJobs a owl:ObjectProperty ;
    rdfs:domain :ResidualFunctionalCapacity ;
    rdfs:range :Occupation ;
    rdfs:label "compatible with jobs" ;
    rdfs:comment "RFC permits performance of this occupation in the national economy" .

:appliesTo a owl:ObjectProperty ;
    rdfs:label "applies to" ;
    rdfs:comment "Generic property: a rule, authority, or limitation applies to a given entity" .

:resultsInDecision a owl:ObjectProperty ;
    rdfs:domain :EvaluationStep ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Determination :DisabilityFinding ) ] ;
    rdfs:label "results in decision" ;
    rdfs:comment "Evaluation step produces this determination or disability finding" .

:ifYesGoTo a owl:ObjectProperty ;
    rdfs:domain :EvaluationStep ;
    rdfs:range :EvaluationStep ;
    rdfs:label "if yes go to" ;
    rdfs:comment "Sequential evaluation branching: favorable determination proceeds to this next step" .

:ifNoGoTo a owl:ObjectProperty ;
    rdfs:domain :EvaluationStep ;
    rdfs:range :EvaluationStep ;
    rdfs:label "if no go to" ;
    rdfs:comment "Sequential evaluation branching: unfavorable determination proceeds to this next step" .

:hasClaim a owl:ObjectProperty ;
    rdfs:domain :Claimant ;
    rdfs:range :MatterType ;
    rdfs:label "has claim" ;
    rdfs:comment "Links a claimant to their SSI or SSDI claim matter" .

:hasPastRelevantWork a owl:ObjectProperty ;
    rdfs:domain :Claimant ;
    rdfs:range :Occupation ;
    rdfs:label "has past relevant work" ;
    rdfs:comment "Links a claimant to occupations constituting past relevant work (Step 4)" .

:protectedBy a owl:ObjectProperty ;
    rdfs:domain :Claimant ;
    rdfs:range [ a owl:Class ; owl:unionOf ( :Statute :Regulation ) ] ;
    rdfs:label "protected by" ;
    rdfs:comment "Statutory or regulatory provision that protects this claimant's rights" .

:subjectToPrivilege a owl:ObjectProperty ;
    rdfs:domain [ a owl:Class ; owl:unionOf ( :Evidence :Document ) ] ;
    rdfs:range :LegalAuthority ;
    rdfs:label "subject to privilege" ;
    rdfs:comment "Evidence or document is subject to a legal privilege established by this authority" .

# =============================================================================
# CARDINALITY CONSTRAINTS (Task 1.1.3)
# =============================================================================

## Claimant must have at least one claim
:Claimant rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasClaim ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

## GridRule applies to exactly one VocationalProfile
:GridRule rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :appliesWhen ;
    owl:cardinality "1"^^xsd:nonNegativeInteger
] .

## EvaluationStep branches to at most one step on a yes outcome
:EvaluationStep rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :ifYesGoTo ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
] .

## EvaluationStep branches to at most one step on a no outcome
:EvaluationStep rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :ifNoGoTo ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
] .

## ResidualFunctionalCapacity has at most one overall exertional level
:ResidualFunctionalCapacity rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :exertionalLevel ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
] .

## Listing must require at least one criterion
:Listing rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :requiresCriterion ;
    owl:minCardinality "1"^^xsd:nonNegativeInteger
] .

## Determination carries at most one DisabilityFinding
:Determination rdfs:subClassOf [
    a owl:Restriction ;
    owl:onProperty :hasFinding ;
    owl:maxCardinality "1"^^xsd:nonNegativeInteger
] .

# =============================================================================
# END OF ONTOLOGY
