    rdfs:domain :MedicalEvidence ;
    rdfs:range :ListingCriterion ;
    rdfs:label "satisfies" ;
    rdfs:comment "Evidence meets this criterion" .

:requiresFindings a owl:ObjectProperty ;
    rdfs:domain :ListingCriterion ;
    rdfs:range :MedicalFinding ;
    rdfs:label "requires findings" .

# =============================================================================
# REASONER HINTS & INFERENCE RULES
# =============================================================================

# Example SWRL rule (would be in separate rules file)
# If claimant has Grid Rule that mandates "Disabled" AND no VE testimony rebuts it, THEN finding is "Disabled"

# Example OWL restriction for Listing satisfaction
:MeetsListing_1_15 a owl:Class ;
    owl:equivalentClass [
        a owl:Class ;
        owl:intersectionOf (
            :Claimant
            [ a owl:Restriction ;
              owl:onProperty :hasMedicalEvidence ;
              owl:someValuesFrom [
                  a owl:Class ;
                  owl:intersectionOf (
                      [ a owl:Restriction ;
                        owl:onProperty :shows ;
                        owl:hasValue :NerveRootCompression ]
                      [ a owl:Restriction ;
                        owl:onProperty :shows ;
                        owl:hasValue :MotorLoss ]
                  )
              ]
            ]
        )
    ] ;
    rdfs:label "Claimant who meets Listing 1.15" .

