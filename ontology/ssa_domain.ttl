:federalBenefitRate a owl:DatatypeProperty ;
    rdfs:domain :SSIBenefitAmount ;
    rdfs:range xsd:decimal ;
    rdfs:label "federal benefit rate" ;
    rdfs:comment "Maximum SSI payment (updated annually)" .

:countableIncome a owl:DatatypeProperty ;
    rdfs:domain :BenefitCalculation ;
    rdfs:range xsd:decimal ;
    rdfs:label "countable income" .

:hasOffset a owl:ObjectProperty ;
    rdfs:domain :ConcurrentBenefitCalculation ;
    rdfs:range :TitleIIOffset ;
    rdfs:label "has offset" .

